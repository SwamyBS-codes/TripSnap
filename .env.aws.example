# AWS S3 mode: leave S3_ENDPOINT and S3_PUBLIC_ENDPOINT empty.
# Attach the Terraform-created EC2 instance profile to your backend EC2 instance.
POSTGRES_USER=tripvault
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=tripvault
DATABASE_URL=postgres://tripvault:replace-me@your-postgres-host:5432/tripvault
JWT_SECRET=replace-with-long-random-secret
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=ap-south-1
S3_ORIGINALS_BUCKET=tripvault-originals-ACCOUNT_ID
S3_PROCESSED_BUCKET=tripvault-processed-ACCOUNT_ID
KAFKA_BROKERS=your-kafka-bootstrap:9092
